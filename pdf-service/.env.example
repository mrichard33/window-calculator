PORT=3000
NODE_ENV=production

# Comma-separated list of exact-match allowed origins.
# NOTE: *.msgsndr.com is handled by a regex in code, not this env var.
ALLOWED_ORIGINS=https://landing.reecewindows.com,https://reecewindows.com

# Path to Chromium binary. On Railway / Debian-based images this is
# installed by the Dockerfile to /usr/bin/chromium.
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

PORT=3000
NODE_ENV=production

# Comma-separated list of exact-match allowed origins.
# NOTE: *.msgsndr.com is handled by a regex in code, not this env var.
ALLOWED_ORIGINS=https://landing.reecewindows.com,https://reecewindows.com

# Path to Chromium binary. On Railway / Debian-based images this is
# installed by the Dockerfile to /usr/bin/chromium.
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# --- Timeouts and retry (added 2026-09-17 after the GHL 524 incident) ---
# PDF generation gets its own budget so a slow GHL upload can never cause a
# finished PDF to be discarded. Each GHL call is retried on timeouts, 5xx, 429
# and network errors; 4xx fails immediately.
# Worst case per GHL stage = MAX_ATTEMPTS * (TIMEOUT_MS + BACKOFF_MAX_MS).
PDF_GENERATE_TIMEOUT_MS=20000
GHL_UPLOAD_TIMEOUT_MS=25000
GHL_CONTACT_TIMEOUT_MS=25000
GHL_UPLOAD_MAX_ATTEMPTS=3
GHL_RETRY_BACKOFF_MAX_MS=8000

# Set to 1 to log raw GHL response bodies while debugging. Off by default —
# it used to log on every successful request.
LOG_GHL_BODIES=0

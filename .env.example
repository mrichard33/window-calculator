# ============================================================
# Window Estimate Calculator v2 — Railway environment variables
# Names match HL MCP service conventions (GHL_API_KEY etc.).
# Set these on the window-calculator service. NEVER commit values.
# ============================================================

# --- GHL (names identical to the HL MCP service) ---
# NEW, minimally-scoped Private Integration Token (contacts read/write only).
# Do NOT reuse the token that was exposed in the old client-side page.
GHL_API_KEY=
GHL_LOCATION_ID=SsBG7j5KQAIP1SFP2Sca
GHL_BASE_URL=https://services.leadconnectorhq.com

# --- GHL workflow webhook triggers (moved out of page source) ---
# Estimate-completed workflow (was GHL_CONFIG.workflowWebhookUrl / f089d6ac)
GHL_ESTIMATE_WEBHOOK_URL=
# Verification-email workflow (was VERIFICATION_WEBHOOK_URL / d056adad)
GHL_VERIFY_WEBHOOK_URL=

# --- PDF microservice (same Railway project) ---
PDF_SERVICE_URL=https://pdf-service-production-ab6a.up.railway.app/api/generate-estimate-pdf

# --- HL MCP Supabase (estimator_events + estimate_jobs tables) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Verification / token signing ---
# 32+ random bytes, e.g.:  openssl rand -hex 32
ESTIMATE_TOKEN_SECRET=
VERIFY_CODE_TTL_MINUTES=10
VERIFY_MAX_ATTEMPTS=5
VERIFY_MAX_SENDS_PER_HOUR=6

# --- Hosting ---
# Comma-separated EXTRA origins allowed to call /api/*. reecewindows.com,
# www.reecewindows.com and estimate.getreecewindows.com are always allowed —
# they are compiled into server.js so a config edit cannot break either page.
# Add the Railway preview domain here if you need to test from it.
ALLOWED_ORIGINS=https://window-calculator-production.up.railway.app

# Railway injects PORT; local default is 8080.

# --- Estimate outbox + retry sweep (added 2026-09-17) ---
# /api/estimate writes every payload to estimate_jobs BEFORE calling
# pdf-service, and POST /api/estimate/sweep retries the ones whose PDF never
# reached GHL. n8n ("E.CALC — Estimate Retry Sweep") calls the sweep every
# 5 minutes. Apply sql/002_estimate_jobs.sql in the Supabase dashboard first.

# Shared secret for the sweep endpoint. REQUIRED: without it the endpoint
# returns 503 rather than standing open, because the /api origin gate lets
# through any request that sends no Origin header.
#   openssl rand -hex 32
SWEEP_TOKEN=

# Give up on a payload after this many attempts and mark it 'dead' (the sweep
# reports the count so n8n can raise a card). The backoff ladder spans a bit
# over a day at the default.
ESTIMATE_JOB_MAX_ATTEMPTS=12

# Completed rows are deleted after this many days. They hold PII — name,
# address, phone, email, pricing — so this is the bound on how long we keep it.
ESTIMATE_JOB_RETENTION_DAYS=30

# One replay's budget, and the whole pass's. HARD_CAP must stay well under the
# n8n httpRequest timeout (120s): a pass that outlives its caller keeps running
# after n8n disconnects, and the next tick starts an overlapping one.
SWEEP_REPLAY_TIMEOUT_MS=45000
SWEEP_PRECHECK_TIMEOUT_MS=10000
SWEEP_HARD_CAP_MS=100000

# How long a claimed row is leased to one sweep. Must exceed SWEEP_HARD_CAP_MS.
ESTIMATE_JOB_LEASE_MS=600000
